# Nusxa: copy .phonix_deploy.env.example .phonix_deploy.env  ( .phonix_deploy.env gitga tushmaydi )
#
# Eng oson deploy: GitHub → aiziyrak-coder/phonixB → Settings → Secrets and variables → Actions
#   PHONIX_SSH_HOST, PHONIX_SSH_USER, PHONIX_SSH_PRIVATE_KEY (to‘liq private key)
# Keyin Actions → "Deploy to server" → Run workflow (lokal PC shart emas).
#
# Lokal tekshiruv: python scripts/check_phonix_deploy_env.py

PHONIX_SSH_HOST=87.192.230.208
PHONIX_SSH_USER=admin_root
PHONIX_SSH_PORT=2222

# Variant A — SSH kalit (tavsiya)
# PHONIX_SSH_KEY=C:\Users\YOU\.ssh\id_ed25519_phonix

# Variant B — parol faylda (birinchi qator = parol; faylni hech kimga bermang)
# PHONIX_SSH_PASSWORD_FILE=C:\Users\YOU\.ssh\phonix_root_password.txt

# Variant C — SSH agent (kalit agentga yuklangan bo‘lsa)
# PHONIX_SSH_USE_AGENT=1

# PHONIX_REMOTE_DIR=/phonix
# PHONIX_BACKEND_LOCAL_PORT=8050
