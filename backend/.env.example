# Django
# PRODUCTION: SECRET_KEY majburiy (uzun, tasodifiy qiymat). DEBUG=False bo'lsa .env da bo'lishi shart.
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database (SQLite - default)
USE_SQLITE=True
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Database (PostgreSQL - production)
# USE_SQLITE=False
# DB_NAME=phoenix_scientific
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS (frontend origin)
# Vite dev server: frontend/vite.config.ts → port 3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Click (to'lov) — maxfiy kalitlar repoda SAQLANMAYDI; faqat server .env yoki xavfsiz vault
# CLICK_MERCHANT_ID=
# CLICK_SERVICE_ID=
# Asosiy service (82154) uchun yoki barcha service uchun mos kalitlar:
CLICK_SECRET_KEY=
# CLICK_MERCHANT_USER_ID=
# Agar bir nechta service_id bo'lsa (ixtiyoriy):
# CLICK_SERVICE_82154_SECRET_KEY=
# CLICK_SERVICE_82155_SECRET_KEY=
# CLICK_SERVICE_89248_SECRET_KEY=
# CLICK_SERVICE_88045_SECRET_KEY=

# HTTPS (nginx orqali; ichki HTTP test uchun SECURE_SSL_REDIRECT=False)
# SECURE_SSL_REDIRECT=True

# Gemini (serverda .env da o'rnating; kalitni GitHubga yozmang)
# GEMINI_API_KEY=your_gemini_api_key

# Demo va Django admin: python manage.py setup_demo_and_admin
# Batafsil: DEMO_LOGIN.md

# Telegram muallif boti (python bot/bot.py — backend/ papkasidan)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_BOT_USERNAME=IlmiyFaoliyatBot
# API_BASE_URL=http://127.0.0.1:8000/api/v1
# FRONTEND_BASE_URL=https://ilmiyfaoliyat.uz

# Ochiq maqola sahifalari (Google Scholar) va QR kodlar uchun sayt manzili
# PUBLIC_SITE_URL=https://ilmiyfaoliyat.uz
# SCHOLAR_EXPOSE_PDF=true

# Crossref DOI depoziti (ixtiyoriy). Login bo'lmasa XML faqat yuklab olinadi.
# CROSSREF_USERNAME=
# CROSSREF_PASSWORD=
# CROSSREF_DOI_PREFIX=10.xxxxx
# CROSSREF_DEPOSITOR_EMAIL=info@ilmiyfaoliyat.uz

# Taqrizchi ishlari muddati (kun)
# SLA_ARTICLE_DAYS=7
# SLA_DOI_DAYS=3
# SLA_UDK_DAYS=2

# Antiplagiat 5.0: barmoq izlari indeksi (python manage.py build_antiplag_index)
# ANTIPLAG_AUTO_INDEX=true
# ANTIPLAG_INDEX_PRIVATE_CHECKS=false
# ANTIPLAG_OPEN_API_QUERIES_PER_MODULE=30
# ANTIPLAG_FULLTEXT_ENABLED=true
# ANTIPLAG_FULLTEXT_MAX_DOCS=10
# ANTIPLAG_WEB_FETCH_PAGES=5
# OAI-PMH manzillari (harvest_oai --all), vergul bilan; bo'sh bo'lsa — standart bepul O'zbekiston manbalari
# (inLibrary, in-academy, O'zMU va b.). CORE uchun bepul kalit: https://core.ac.uk/services/api
# ANTIPLAG_CORE_API_KEY=
# ANTIPLAG_OAI_SOURCES=https://jurnal1.uz/index.php/j1/oai,https://jurnal2.uz/index.php/j2/oai
