# Phoenix — taqrizchilarga muddat eslatmasi (bir martalik ishga tushirish; phoenix-reminders.timer chaqiradi).
#
# O'rnatish:
#   sudo cp phoenix-reminders.service.example /etc/systemd/system/phoenix-reminders.service
#   sudo cp phoenix-reminders.timer.example   /etc/systemd/system/phoenix-reminders.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now phoenix-reminders.timer
# Tekshirish:  systemctl list-timers | grep phoenix ;  journalctl -u phoenix-reminders
# User/Group va yo'llarni phoenix-backend.service bilan bir xil qiling.

[Unit]
Description=Phoenix — taqrizchilarga muddat eslatmalari
After=network.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/phonix/backend
Environment=PATH=/phonix/backend/venv/bin
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/phonix/backend/venv/bin/python manage.py send_deadline_reminders
