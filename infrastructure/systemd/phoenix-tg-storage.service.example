# Phoenix — Telegram fayl ombori: yuborilmagan media fayllarni kanalga yuborish, uzoq ochilmagan fayllarni
# diskdan o'chirish (Telegram'da nusxasi borlarini), Bot API keshini tozalash. phoenix-tg-storage.timer chaqiradi.
# Telegram sozlanmagan bo'lsa (TG_STORAGE_*) hech narsa qilmaydi.
#
# O'rnatish (deploy_phonix.sh o'zi ham o'rnatadi):
#   sudo cp phoenix-tg-storage.service.example /etc/systemd/system/phoenix-tg-storage.service
#   sudo cp phoenix-tg-storage.timer.example   /etc/systemd/system/phoenix-tg-storage.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now phoenix-tg-storage.timer
# Tekshirish:  journalctl -u phoenix-tg-storage -n 50 ;  python manage.py tgstorage status

[Unit]
Description=Phoenix — Telegram fayl ombori sinxronlash
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/phonix/backend
Environment=PATH=/phonix/backend/venv/bin:/usr/bin:/bin
Environment=DJANGO_SETTINGS_MODULE=config.settings
Nice=10
ExecStart=/phonix/backend/venv/bin/python manage.py tgstorage sync --evict
ExecStart=-/phonix/backend/venv/bin/python manage.py tgstorage cleanup-cache
TimeoutStartSec=2h
